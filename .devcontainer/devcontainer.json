{
  "name": "TeamAI Dev",
  "image": "mcr.microsoft.com/devcontainers/javascript-node:20",
  "remoteUser": "node",

  "mounts": [
    "source=${localEnv:USERPROFILE}\\.claude,target=/home/node/.claude,type=bind",
    "source=${localEnv:USERPROFILE}\\.gitconfig,target=/home/node/.gitconfig,type=bind",
    "source=${localEnv:USERPROFILE}\\.ssh,target=/home/node/.ssh,type=bind,readonly"
  ],

  "postCreateCommand": "npm install -g @anthropic-ai/claude-code playwright-mcp && sudo apt-get update -q && sudo apt-get install -y -q gh",

  "forwardPorts": [3000],

  "remoteEnv": {
    "NODE_ENV": "development"
  }
}

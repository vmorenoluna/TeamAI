{
  "name": "Dev Container",
  "image": "mcr.microsoft.com/devcontainers/javascript-node:{{NODE_VERSION}}",
  "remoteUser": "node",

  "mounts": [
    "source=${localEnv:USERPROFILE}\\.claude,target=/home/node/.claude,type=bind",
    "source=${localEnv:USERPROFILE}\\.gitconfig,target=/home/node/.gitconfig,type=bind",
    "source=${localEnv:USERPROFILE}\\.ssh,target=/home/node/.ssh,type=bind,readonly"
  ],

  "features": {
    "ghcr.io/devcontainers/features/github-cli:1": {}
    {{EXTRA_FEATURES}}
  },

  "postCreateCommand": "npm install -g @anthropic-ai/claude-code && sudo apt-get update -q && sudo apt-get install -y -q gh{{EXTRA_APT}} && sudo git config --system --add safe.directory '*'",
  "postStartCommand": "npm install -g @anthropic-ai/claude-code@latest || echo 'claude-code update skipped (offline?)'",

  "remoteEnv": {
    "NODE_ENV": "development"
  }
}

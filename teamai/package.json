{
  "name": "teamai",
  "version": "0.1.0",
  "description": "Multi-agent Claude Code CLI orchestration with a browser UI",
  "license": "MIT",
  "author": "TeamAI",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vmorenoluna/TeamAI.git"
  },
  "bugs": {
    "url": "https://github.com/vmorenoluna/TeamAI/issues"
  },
  "homepage": "https://github.com/vmorenoluna/TeamAI#readme",
  "private": true,
  "main": "electron/main.js",
  "scripts": {
    "dev": "cross-env PORT=3002 tsx watch server.ts",
    "build": "next build",
    "build:server": "node scripts/build-server.mjs",
    "build:electron": "npm run build && node scripts/fix-external-symlinks.mjs && npm run build:server",
    "start": "cross-env NODE_ENV=production tsx server.ts",
    "lint": "eslint --max-warnings 0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:unit": "vitest run --exclude \"tests/integration/**\"",
    "test:integration": "vitest run tests/integration",
    "pretest:e2e": "node scripts/clear-port-3001.mjs 3001 && npm run build:electron",
    "test:e2e": "playwright test",
    "pretest:e2e:smoke": "node scripts/clear-port-3001.mjs 3001 && npm run build:electron",
    "test:e2e:smoke": "playwright test tests/e2e/sidebar.spec.ts tests/e2e/task-detail.spec.ts tests/e2e/kanban.spec.ts tests/e2e/settings.spec.ts tests/e2e/workflow.spec.ts",
    "test:changelog": "bash tests/unit/changelog-parsing.test.sh",
    "test:all": "npm run typecheck && npm run lint && npm run test && npm run test:e2e && npm run test:changelog",
    "test:all:coverage": "npm run typecheck && npm run lint && vitest run --coverage && npm run test:e2e && npm run test:changelog && node -e \"console.log('\\n=== Combined Coverage ==='); console.log('  Vitest HTML: coverage/index.html'); console.log('  Vitest summary + Playwright results: see above.')\"",
    "test:pr:coverage": "npm run typecheck && npm run lint && vitest run --coverage && npm run test:e2e:smoke && npm run test:changelog && node -e \"console.log('\\n=== Combined Coverage ==='); console.log('  Vitest HTML: coverage/index.html'); console.log('  Vitest summary + Playwright results: see above.')\"",
    "precommit": "node -e \"console.log('Running full test suite before commit...')\" && npm run test:all",
    "prepare": "node -e \"var e=require('child_process').execSync;try{e('git config core.hooksPath .husky',{cwd:'..'})}catch(_){};if(process.platform!=='win32')try{e('chmod +x .husky/pre-commit',{cwd:'..'})}catch(_){};process.exit(0)\"",
    "electron:dev": "cross-env ELECTRON_DEV=true electron .",
    "electron:build": "npm run build:electron && electron-builder --win",
    "electron:build:mac": "npm run build:electron && electron-builder --mac",
    "electron:build:linux": "npm run build:electron && electron-builder --linux",
    "electron:build:all": "npm run build:electron && electron-builder --win --mac --linux",
    "preelectron:start": "npm run build:electron",
    "electron:start": "cross-env NODE_ENV=production ELECTRON_DEV=false electron ."
  },
  "dependencies": {
    "@devcontainers/cli": "^0.86.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "cross-spawn": "^7.0.6",
    "electron-updater": "^6.8.9",
    "next": "^16.2.7",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "tsx": "^4.21.0",
    "ws": "^8.20.0"
  },
  "optionalDependencies": {
    "node-pty": "^1.1.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "@tailwindcss/postcss": "^4",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/cross-spawn": "^6.0.6",
    "@types/node": "^20.19.39",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^4.7.0",
    "@vitest/coverage-v8": "^1.6.1",
    "cross-env": "^10.1.0",
    "electron": "^33.4.0",
    "electron-builder": "^25.1.8",
    "eslint": "^9",
    "eslint-config-next": "16.2.4",
    "happy-dom": "^20.9.0",
    "husky": "^9.1.7",
    "jsdom": "^29.1.1",
    "lint-staged": "^15.5.2",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^1.6.1"
  },
  "lint-staged": {
    "*.{ts,tsx,mts}": [
      "eslint --fix",
      "eslint --max-warnings 0"
    ]
  },
  "build": {
    "appId": "com.teamai.app",
    "productName": "TeamAI",
    "directories": {
      "output": "dist-electron"
    },
    "files": [
      "electron/**/*",
      "dist-server/**/*",
      "external-shims/**/*",
      ".next/**/*",
      "node_modules/**/*",
      "package.json",
      "public/**/*",
      "defaults/**/*",
      "!node_modules/.cache",
      "!node_modules/@img/sharp-darwin-*/**",
      "!node_modules/@img/sharp-libvips-darwin-*/**",
      "!node_modules/@img/sharp-libvips-linux-*/**",
      "!node_modules/@img/sharp-libvips-android-*/**",
      "!node_modules/@esbuild/darwin-*/**",
      "!node_modules/@esbuild/linux-*/**",
      "!node_modules/@esbuild/freebsd-*/**",
      "!node_modules/@esbuild/openbsd-*/**",
      "!node_modules/@esbuild/sunos-*/**",
      "!node_modules/@esbuild/android-*/**",
      "!node_modules/**/docs/**",
      "!node_modules/**/test/**",
      "!node_modules/**/tests/**",
      "!node_modules/**/__tests__/**",
      "!node_modules/**/example/**",
      "!node_modules/**/examples/**",
      "!node_modules/**/*.md",
      "!node_modules/**/*.map",
      "!node_modules/**/LICENSE",
      "!node_modules/**/CHANGELOG*"
    ],
    "electronLanguages": [
      "en-US"
    ],
    "win": {
      "target": [
        "nsis",
        "zip"
      ],
      "icon": "public/icon.png",
      "signAndEditExecutable": false
    },
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "icon": "public/icon.png"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "icon": "public/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "publish": {
      "provider": "github",
      "owner": "vmorenoluna",
      "repo": "TeamAI"
    },
    "npmRebuild": false,
    "asar": false
  }
}

# Dependencies (installed per-machine, never committed)
node_modules/

# Playwright output
.playwright-mcp/
test-results/

# TypeScript build artifacts
*.tsbuildinfo

# Server logs
dev_server.log
orchestrator_*.txt

# Coverage output
cov.txt
coverage_output.txt
coverage_verbose.txt
full_coverage.txt
full_coverage2.txt

# Test artifacts
.teamai-test-*
.teamai-e2e-seed
.teamai-e2e-seed-diag
.teamai/

# Demo project: generated source tree, its own throwaway git repo, and the
# .gitignore/.gitattributes TeamAI scaffolds into any registered project — all
# recreated by seed-demo.ts / on project open (the repo exists so the DONE
# column has real git history to reconstruct tickets from)
/demo/src/
/demo/.git/
/demo/.gitignore
/demo/.gitattributes

# Git worktrees (generated at runtime)
worktrees/

# OS
.DS_Store

# Editor / local tooling state
.idea/
.mcp.json
.claude/settings.local.json

# TeamAI — exclude transient pipeline files
.teamai/*
